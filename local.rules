alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL Outbound HTTP with WinHttp script User-Agent"; flow:established,to_server; http.user_agent; content:"WinHttp.WinHttpRequest"; sid:9000001; rev:1;)
alert dns $HOME_NET any -> any any (msg:"LOCAL Known Pushdo dropper domain matied.com"; dns.query; content:"matied.com"; nocase; endswith; sid:9000002; rev:1;)
